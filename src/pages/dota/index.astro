---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import WhySetupSection from '../../components/WhySetupSection.astro';
import ProductsSection from '../../components/ProductsSection.astro';
import ContentSections from '../../components/ContentSections.astro';
import { resolvePageSeo } from '../../config/seo';
import { webpSrc } from '../../utils/responsiveImage';
import { padMetaDescription, padPageTitle } from '../../utils/metaPad';

const rawSeo = resolvePageSeo('/dota/');
const seo = { title: padPageTitle(rawSeo.title), description: padMetaDescription(rawSeo.description) };
const heroLcpImage = webpSrc('/images/gameplay/dota-2-map-hack.png', 512);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>

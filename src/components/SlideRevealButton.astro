---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'button'> &
  HTMLAttributes<'a'> & {
    /** Use `button` for dialog triggers (no navigation). */
    as?: 'a' | 'button';
    href?: string;
    type?: 'button' | 'submit' | 'reset';
    class?: string;
    ariaLabel?: string;
    icon?: IconName;
  };

const {
  as = 'a',
  href,
  type = 'button',
  class: className,
  ariaLabel,
  icon = 'arrowRight',
  ...rest
} = Astro.props as Props;
const sharedClasses = ['slide-reveal-btn', className];
---

{
  as === 'button' ? (
    <button type={type} class:list={sharedClasses} aria-label={ariaLabel} {...rest}>
      <span class="slide-reveal-btn__icon" aria-hidden="true">
        <Icon name={icon} size={18} class="slide-reveal-btn__svg" />
      </span>
      <span class="slide-reveal-btn__text">
        <slot />
      </span>
    </button>
  ) : (
    <a href={href} class:list={sharedClasses} aria-label={ariaLabel} {...rest}>
      <span class="slide-reveal-btn__icon" aria-hidden="true">
        <Icon name={icon} size={18} class="slide-reveal-btn__svg" />
      </span>
      <span class="slide-reveal-btn__text">
        <slot />
      </span>
    </a>
  )
}

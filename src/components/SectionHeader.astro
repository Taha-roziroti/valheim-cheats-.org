---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  /** Use h1 only for the page’s primary heading; sections default to h2 (one h1 per page). */
  heading?: 'h1' | 'h2';
  centered?: boolean;
  wide?: boolean;
}

const { eyebrow, title, desc, titleId, heading = 'h2', centered = false, wide = false } = Astro.props;

const HeadingTag = heading;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <HeadingTag id={titleId} class="section-header__title">{title}</HeadingTag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
